DJANGO_DEBUG=True
# For a production deployment set DJANGO_DEBUG=False and provide the required
# secret, hosts, CORS origins, template keys, and calibrated thresholds below.
# Low-quality-camera submission mode: capture frames under the Iris step,
# verify face + voice, and do not use iris as identity evidence. Set False
# for production three-modal authentication.
FACE_PRIMARY_CAPTURE_MODE=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Point this to a local cached SpeechBrain model if you want to avoid
# first-run downloads.
VOICE_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
VOICE_MODEL_CACHE_DIR=
LOCAL_VOICE_MODEL_DIR=trained_models/voice

# Optional overrides for the downloaded MediaPipe face/iris landmark model.
IRIS_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
IRIS_MODEL_CACHE_DIR=
IRIS_MODEL_PATH=
LOCAL_IRIS_ONNX_MODEL_PATH=trained_models/iris/iris_semseg_upp_scse_mobilenetv2.onnx
FACE_MODEL_ROOT=trained_models/face
FACE_MODEL_NAME=buffalo_l
FACE_DETECTION_THRESHOLD=0.65
FACE_QUALITY_THRESHOLD=0.60
FACE_SIMILARITY_THRESHOLD=0.70

# Dedicated face anti-spoofing / liveness model (separate from the SCRFD face
# detector; SCRFD confidence is never treated as liveness). Place a
# MiniFASNet-compatible ONNX file under trained_models/face/antispoof/ or set
# an explicit path. Enrollment and login fail closed while this model is
# missing unless FACE_LIVENESS_REQUIRED=False (non-production diagnostics).
FACE_LIVENESS_MODEL_DIR=trained_models/face
FACE_LIVENESS_MODEL_PATH=trained_models/face/antispoof/minifasnet_v2.onnx
# Optional one-time provisioning URL (only used when BIOMETRIC_OFFLINE_MODE=False).
FACE_LIVENESS_MODEL_URL=
FACE_LIVENESS_MODEL_NAME=MiniFASNet face anti-spoofing
FACE_LIVENESS_INPUT_SIZE=80
FACE_LIVENESS_CROP_SCALE=2.7
# Index of the "live" class in the classifier output. Decision basis: the
# A/B/C diagnostic (backend/diag_liveness.py) plus the upstream implementation
# (yakhyo/face-anti-spoofing onnx_inference.py): BGR, float32 RAW 0-255 pixels,
# NCHW, 2.7 crop, class index 1 = Real. The Hugging Face model card documents
# /255 with class 0 = live, but the checkpoint's observed behaviour (same real
# webcam face and crop: /255 -> argmax 2 [0.0004, 0.0061, 0.9935]; raw 0-255 ->
# argmax 1 [0.0071, 0.9799, 0.0131]; upstream-replica pipeline agreed) matches
# the upstream Silent-Face/MiniFASNet convention. Not chosen because it
# produces PASS.
FACE_LIVENESS_LIVE_INDEX=1
# Save the exact classifier-input face crop under media/liveness_debug/ for
# manual inspection. Diagnostics only; leave False in production.
FACE_LIVENESS_DEBUG_SAVE_CROP=False
# softmax | sigmoid | none
FACE_LIVENESS_ACTIVATION=softmax
FACE_LIVENESS_THRESHOLD=0.60
# Required in production. The settings default is "not DEBUG", so a development
# machine without the asset still runs face/iris/voice and reports liveness as
# UNAVAILABLE instead of fabricating a pass. Production startup rejects False.
FACE_LIVENESS_REQUIRED=False
# Challenge-based temporal liveness (registration/login gate on top of
# the single-frame PAD model above). The backend issues a random action
# (blink / turn-left / turn-right) that must be verified over consecutive
# webcam frames; frames live only in memory and are discarded after inference.
FACE_CHALLENGE_SESSION_TTL=180
FACE_CHALLENGE_TOKEN_MAX_AGE=600
FACE_CHALLENGE_MIN_FRAMES=6
FACE_CHALLENGE_MAX_FRAMES=30
FACE_CHALLENGE_MOTION_THRESHOLD=2.0
FACE_CHALLENGE_MOTION_FRAMES=2
FACE_CHALLENGE_OPEN_THRESHOLD=0.16
FACE_CHALLENGE_CLOSED_THRESHOLD=0.09
FACE_CHALLENGE_CLOSED_FRAMES=2
FACE_CHALLENGE_TURN_THRESHOLD=0.18
FACE_CHALLENGE_TURN_FRAMES=2
MAX_FACE_UPLOAD_BYTES=12582912
MIN_FACE_SAMPLES=3
MIN_IRIS_SAMPLES=3
MIN_VOICE_SAMPLES=3
# Login capture count. Keep at one: each live frame is still quality-gated
# and compared against the multi-sample enrollment template.
AUTH_FACE_SAMPLES=1
AUTH_IRIS_SAMPLES=1
MIN_VOICE_SEGMENTS=2
# Comma-separated Fernet keys. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_TEMPLATE_KEYS=
IRIS_ONNX_INPUT_SIZE=320
MODEL_DOWNLOAD_TIMEOUT_SECONDS=60

VOICE_SAMPLE_RATE=16000
VOICE_MIN_SECONDS=2
VOICE_MAX_SECONDS=15
VOICE_QUALITY_THRESHOLD=0.55
VOICE_ACTIVITY_THRESHOLD=0.35
VOICE_SIMILARITY_THRESHOLD=0.75
IRIS_QUALITY_THRESHOLD=0.55
IRIS_SIMILARITY_THRESHOLD=0.78
FUSION_FACE_WEIGHT=0.34
FUSION_VOICE_WEIGHT=0.33
FUSION_IRIS_WEIGHT=0.33
FUSION_THRESHOLD=0.80
# Development may use configured thresholds. Production must set this False
# and provide FUSION_CALIBRATION_PATH generated from representative genuine
# and impostor sessions; authentication fails closed if calibration is absent.
DEVELOPMENT_THRESHOLDS=True
FUSION_CALIBRATION_PATH=trained_models/fusion_calibration.json
RETAIN_PROCESSED_UPLOADS=False

# Production-only examples (uncomment and replace values):
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long-random-secret>
# FACE_PRIMARY_CAPTURE_MODE=False
# DEVELOPMENT_THRESHOLDS=False
# DJANGO_ALLOWED_HOSTS=app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# BIOMETRIC_TEMPLATE_KEYS=<fernet-key>
# SECURE_SSL_REDIRECT=True

